---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import TitleBar from '../components/TitleBar.astro';
import type { Section } from '../components/TitleBar.astro';
import { site } from '../data/about';

interface Props {
  title: string;
  description?: string;
  /** Omit on the home page — there the desktop icons are the navigation. */
  section?: Section;
}

const { title, description = site.description, section } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Christina Wang" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#c1633a" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    {import.meta.env.PROD && <Analytics />}
  </head>
  <body
    class="flex min-h-screen flex-col bg-sand px-5 py-8 font-sans text-ink lowercase antialiased"
  >
    <main class="mx-auto flex w-full max-w-[900px] flex-1 items-center">
      <div class="w-full overflow-hidden rounded-2xl bg-paper shadow-window">
        {section && <TitleBar section={section} />}
        <slot />
      </div>
    </main>
  </body>
</html>
