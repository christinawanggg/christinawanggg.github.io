---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Essay from './Essay.astro';
import EssayList from './EssayList.astro';

export interface EssayEntry {
  id: string;
  title: string;
  date: Date;
  Content: AstroComponentFactory;
}

interface Props {
  essays: EssayEntry[];
}

const { essays } = Astro.props;
---

{/* data-view drives the mobile push navigation; md+ always shows both panes. */}
<div
  data-notes
  data-view="list"
  class="group/notes min-h-[520px] md:flex md:h-[520px] md:min-h-0"
>
  <h1 class="sr-only">writing</h1>

  <EssayList
    essays={essays}
    currentId={essays[0]?.id ?? ''}
    class="group-data-[view=detail]/notes:hidden md:block md:w-[32%] md:overflow-y-auto md:border-r"
  />

  <div class="hidden group-data-[view=detail]/notes:block md:block md:flex-1 md:overflow-y-auto">
    <button
      type="button"
      data-notes-back
      class="flex w-full cursor-pointer items-center gap-1 border-b border-line px-4 py-3 text-xs text-terracotta md:hidden"
    >
      <span aria-hidden="true">‹</span> all essays
    </button>

    {
      essays.map(({ id, title, date, Content }, i) => (
        <article data-detail={id} class="p-6" hidden={i !== 0}>
          <Essay title={title} date={date} Content={Content} as="h2" />
        </article>
      ))
    }
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-notes]');
  if (root) {
    const items = root.querySelectorAll<HTMLAnchorElement>('[data-essay]');
    const details = root.querySelectorAll<HTMLElement>('[data-detail]');
    const back = root.querySelector<HTMLButtonElement>('[data-notes-back]');
    const indexTitle = document.title;

    /** Select an essay, or pass null for the index (mobile list view). */
    const show = (id: string | null) => {
      const target = id ?? items[0]?.dataset.essay ?? null;
      const row = [...items].find((i) => i.dataset.essay === target);

      items.forEach((i) => i.setAttribute('aria-current', String(i.dataset.essay === target)));
      details.forEach((d) => {
        d.hidden = d.dataset.detail !== target;
      });
      root.dataset.view = id ? 'detail' : 'list';
      document.title = id && row?.dataset.title ? `${row.dataset.title} — christina wang` : indexTitle;
    };

    // Analytics counts one page_view per page load. Swapping an essay in place
    // never reloads, so these reads have to report themselves or go uncounted.
    const trackView = () => {
      const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
      gtag?.('event', 'page_view', {
        page_title: document.title,
        page_location: location.href,
      });
    };

    items.forEach((item) => {
      item.addEventListener('click', (event) => {
        // Each row is a real link to the essay's own page, so it stays
        // crawlable and cmd-clickable. Plain clicks swap in place instead.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        if (location.pathname === new URL(item.href).pathname) return;

        show(item.dataset.essay ?? null);
        history.pushState(null, '', item.href);
        trackView();
        window.scrollTo({ top: 0 });
      });
    });

    back?.addEventListener('click', () => {
      show(null);
      history.pushState(null, '', '/writing/');
      trackView();
    });

    // Keep the back/forward buttons in step with what's on screen.
    addEventListener('popstate', () => {
      const match = location.pathname.match(/^\/writing\/(.+?)\/?$/);
      show(match ? match[1] : null);
    });
  }
</script>
