---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

export interface EssayEntry {
  id: string;
  title: string;
  date: Date;
  Content: AstroComponentFactory;
}

interface Props {
  essays: EssayEntry[];
}

const { essays } = Astro.props;

const formatDate = (date: Date) =>
  date
    .toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    .toLowerCase();
---

{/* data-view drives the mobile push navigation; md+ always shows both panes. */}
<div
  data-notes
  data-view="list"
  class="group/notes min-h-[520px] md:flex md:h-[520px] md:min-h-0"
>
  <div
    class="border-line bg-shell p-3 group-data-[view=detail]/notes:hidden md:block md:w-[32%] md:overflow-y-auto md:border-r"
  >
    {
      essays.map(({ id, title, date }, i) => (
        <button
          type="button"
          data-essay={id}
          aria-label={`${title}, ${formatDate(date)}`}
          aria-current={i === 0 ? 'true' : 'false'}
          class="mb-[3px] w-full cursor-pointer rounded-lg p-2.5 text-left hover:bg-hover md:aria-[current=true]:bg-blush"
        >
          <span class="block text-xs font-semibold">{title}</span>
          <span class="mt-0.5 block text-[10px] text-muted">{formatDate(date)}</span>
        </button>
      ))
    }
  </div>

  <div
    class="hidden group-data-[view=detail]/notes:block md:block md:flex-1 md:overflow-y-auto"
  >
    <button
      type="button"
      data-notes-back
      class="flex w-full cursor-pointer items-center gap-1 border-b border-line px-4 py-3 text-xs text-terracotta md:hidden"
    >
      <span aria-hidden="true">‹</span> all essays
    </button>

    {
      essays.map(({ id, title, date, Content }, i) => (
        <article data-detail={id} class="p-6" hidden={i !== 0}>
          <h1 class="text-base font-bold">{title}</h1>
          <p class="mt-1 mb-3.5 text-[11px] text-muted">{formatDate(date)}</p>
          <div class="essay text-[13px] leading-[1.7] text-stone">
            <Content />
          </div>
        </article>
      ))
    }
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-notes]');
  if (root) {
    const items = root.querySelectorAll<HTMLButtonElement>('[data-essay]');
    const details = root.querySelectorAll<HTMLElement>('[data-detail]');
    const back = root.querySelector<HTMLButtonElement>('[data-notes-back]');

    items.forEach((item) => {
      item.addEventListener('click', () => {
        items.forEach((i) => i.setAttribute('aria-current', String(i === item)));
        details.forEach((d) => {
          d.hidden = d.dataset.detail !== item.dataset.essay;
        });
        root.dataset.view = 'detail';
        window.scrollTo({ top: 0 });
      });
    });

    back?.addEventListener('click', () => {
      root.dataset.view = 'list';
    });
  }
</script>
